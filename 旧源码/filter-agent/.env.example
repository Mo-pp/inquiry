DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=30

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=lintratek_chat

API_HOST=127.0.0.1
API_PORT=8000

GOOGLE_SPREADSHEET_ID=107j9EZZY5GFEUL_6o83bsO32o978_-ro5kpi0PJ-GWw
GOOGLE_SHEET_GID=0
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=google-token.json
GOOGLE_SHEETS_POLL_INTERVAL_SECONDS=60
# Safety gate: set to true only when production form ingestion is explicitly approved.
GOOGLE_SHEETS_SYNC_ENABLED=false
# Use "api" after Google Cloud OAuth setup, or "apps_script" to avoid Cloud billing.
GOOGLE_SHEETS_SOURCE=apps_script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Service-side WhatsApp intake. Keep disabled until the staged rollout is approved.
WHATSAPP_INBOUND_ENABLED=false
WHATSAPP_INBOX_LEASE_SECONDS=300
WHATSAPP_INBOX_BATCH_SIZE=20

# Outreach planning/retry defaults. Real sending has separate phase-5 gates.
OUTREACH_DRY_RUN=true
OUTREACH_MAX_ATTEMPTS=3
OUTREACH_RETRY_DELAYS_SECONDS=30,120,600

# Local wa-bridge endpoint used by the future, explicitly gated outreach sender.
WA_BRIDGE_URL=http://127.0.0.1:3010
WA_BRIDGE_TIMEOUT_SECONDS=10
