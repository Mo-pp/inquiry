WA_BRIDGE_HOST=127.0.0.1
WA_BRIDGE_PORT=3010
WA_HEADLESS=false
WA_CLIENT_ID=filter-agent
WA_SESSION_PATH=.wa-session
WA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Phase-3 service-side inbound handoff. Keep disabled until the migration is
# reviewed and the additive MySQL migration has been approved.
WA_INBOUND_ENABLED=false
WA_INBOUND_URL=http://127.0.0.1:8000/api/v1/whatsapp/inbound
WA_INBOUND_TIMEOUT_MS=10000
WA_INBOUND_FORWARD_ATTEMPTS=3
WA_INBOUND_FORWARD_RETRY_DELAY_MS=1000
WA_COMPENSATION_SCAN_ON_READY=false
WA_COMPENSATION_MESSAGES_PER_CHAT=50
# Set a positive value to repeat the bounded scan while the bridge is ready.
# The scan remains disabled unless inbound forwarding is enabled.
WA_COMPENSATION_SCAN_INTERVAL_SECONDS=0
