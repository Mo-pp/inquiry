# Local HTTP port. Restart after changing configuration.
WA_BRIDGE_PORT=3010
# false opens an interactive Chrome window for QR login.
WA_HEADLESS=false
# Leave empty to locate installed Google Chrome automatically.
WA_CHROME_PATH=

# Enable once the two Python turn endpoints are available.
WA_TURNS_ENABLED=false
WA_PYTHON_URL=http://127.0.0.1:8000
WA_SILENCE_SECONDS=20
